  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.72, g: 0.76, b: 0.82, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 16
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "- CONTINUOUS HABIT TRACKING:\n  * Dodge Bias (Direction & Timing)\n  * Attack Cadence & Combo Rhythm\n  * Distance & Spacing (Kiting vs Melee Pressure)\n  * Healing Window Timing (Punish Window)\n  * Defense Preference (Deflect vs Block vs Dodge)\n\n- ADAPTATION THRESHOLD (0.65 Confidence):\n  * Roll Spammers -> Boss deploys Wide Sweeps (4.0m, 120\xB0 arc)\n  * Aggressive Attackers -> Boss counters with Hyper-Armour Jabs\n    (0.28s startup) & reactive Parry Stances\n  * Kiters / Runners -> Boss unleashes 16 m/s Charge (Knockdown)\n  * Guard Turtles -> Boss unleashes Perilous Overhead (Unblockable)\n\n- PHASE 2 ENRAGE (< 50% Boss HP):\n  * Attack recovery & cooldowns reduced by 20%\n  * Cataclysmic Wave unlocked (8.5m arena-wide perilous wave)\n  * Resolve gambits trigger on posture threats."
